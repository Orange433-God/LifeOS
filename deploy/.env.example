# ===== LifeOS 部署环境变量（复制为仓库根目录 .env 后填写）=====
# 生成随机密钥：openssl rand -hex 32

# MySQL root 密码（建议强随机）
MYSQL_ROOT_PASSWORD=change-me-strong-password

# JWT 签名密钥（必须更换为随机值，两个都要填）
JWT_SECRET=change-me-jwt-secret
REFRESH_SECRET=change-me-refresh-secret

# 前端可访问的站点地址（CORS 用；按 IP 访问填 http://你的服务器IP，有域名填 https://你的域名）
CLIENT_URL=http://localhost

# DeepSeek API（AI 伙伴对话 + 记录解析；key 在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
FAST_CHAT_MODEL=deepseek-v4-flash
VL_MODEL_NAME=deepseek-v4-flash-vision-exp
RECORD_PARSE_MODEL=deepseek-v4-flash
