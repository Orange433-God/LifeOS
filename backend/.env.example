# ===== 数据库 =====
# MySQL 连接串（请改成你自己的账号密码；数据库需先创建：CREATE DATABASE lifeos）
DATABASE_URL="mysql://root:password@localhost:3306/lifeos"

# ===== 安全（生产环境务必更换为随机强密钥）=====
JWT_SECRET="lifeos-dev-access-secret"
REFRESH_SECRET="lifeos-dev-refresh-secret"

# ===== 服务 =====
PORT=4000
CLIENT_URL="http://localhost:5173"
# Python AI 伙伴微服务（lifeos-ai-service）
AI_SERVICE_URL="http://localhost:8000"

# ===== DeepSeek API（人生记录 AI 解析，缺失时自动降级本地规则）=====
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
RECORD_PARSE_MODEL=deepseek-v4-flash
