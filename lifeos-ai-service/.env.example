# DeepSeek API 配置（OpenAI 兼容格式）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
# 多模态模型：以 DeepSeek 平台实际提供的名称为准（deepseek-chat/deepseek-vl 均为历史名称）
VL_MODEL_NAME=deepseek-v4-flash-vision-exp
# 对话快速通道模型（低延迟）
FAST_CHAT_MODEL=deepseek-v4-flash

# 服务配置（可选）
SERVICE_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4000
